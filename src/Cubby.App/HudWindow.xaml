<Window x:Class="Cubby.App.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cubby · 浮层诊断面板"
        Width="720"
        Height="640"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="M1 · 多显示器浮层诊断" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="#52525B"
                       Text="每台显示器一个浮层窗口。盒子区域内应该能收到点击，盒子外的透明区域必须把点击原样放行给桌面 / 动态壁纸。把鼠标移到任意位置，看「光标命中窗口」一行即可判断。" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <UniformGrid Columns="2" Margin="0,0,0,8">
                <Button x:Name="ToggleModeButton" Content="切换命中模式（A 逐像素 / B 区域）" Margin="0,0,4,0" Padding="8" Click="OnToggleMode" />
                <Button Content="全部立即置底" Margin="4,0,0,0" Padding="8" Click="OnEnsureBehind" />
            </UniformGrid>
            <UniformGrid Columns="3">
                <Button x:Name="RebuildButton" Content="重新枚举显示器" Margin="0,0,4,0" Padding="8" Click="OnRebuild" />
                <Button x:Name="SelfTestButton" Content="运行自动自测（会短暂移动鼠标）" Margin="4,0,4,0" Padding="8" Click="OnRunSelfTest" />
                <Button Content="退出" Margin="4,0,0,0" Padding="8" Click="OnExit" />
            </UniformGrid>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#02743B" />
        </StackPanel>

        <Border BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="8" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DiagText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

    </DockPanel>
</Window>