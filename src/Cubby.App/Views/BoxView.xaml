<UserControl x:Class="Cubby.App.Views.BoxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             DragOver="OnDragOver"
             Drop="OnDrop">
    <!--
        设计约束（P2）：盒子的所有绘制都必须落在盒子矩形内部。
        这里刻意不使用任何 Effect（阴影 / 模糊都会向外扩散成 alpha>0 的像素，从而抢走盒子外的点击）。
        立体感一律用「渐变底 + 顶部高光 + 左侧强调条 + 描边」实现。
    -->
    <Grid>
        <Border x:Name="Root" BorderThickness="1">
            <Grid>
                <!--
                    左侧强调条：**默认不显示**，只在"需要提醒"的状态下由代码点亮
                    （锁定 / 映射文件夹）。普通盒子不画任何色条——
                    桌面上一眼望去全是彩色竖条，是上一版最刺眼的观感问题。
                -->
                <Border x:Name="AccentBar"
                        Width="2.5"
                        Height="22"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        CornerRadius="1.25"
                        Margin="0,7,0,0"
                        Visibility="Collapsed" />

                <DockPanel>

                    <Border x:Name="TitleBar"
                            DockPanel.Dock="Top"
                            Height="36"
                            Background="Transparent"
                            BorderThickness="0,0,0,1"
                            BorderBrush="#12FFFFFF"
                            MouseLeftButtonDown="OnTitleMouseDown"
                            MouseMove="OnTitleMouseMove"
                            MouseLeftButtonUp="OnTitleMouseUp">
                        <Grid>
                            <TextBlock x:Name="TitleIcon"
                                       Margin="14,0,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Cubby.Font.Icon}"
                                       FontSize="11"
                                       Visibility="Collapsed" />

                            <TextBlock x:Name="TitleText"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="DesktopIconButton"
                                        Style="{StaticResource Cubby.Button.Icon}"
                                        Margin="0,0,2,0"
                                        ToolTip="隐藏 / 显示真实桌面图标（Ctrl+Alt+H）"
                                        Click="OnToggleDesktopIcons" />
                                <Button x:Name="SearchButton"
                                        Style="{StaticResource Cubby.Button.Icon}"
                                        Margin="0,0,2,0"
                                        ToolTip="搜索这个盒子里的条目"
                                        Click="OnSearch" />
                                <Button x:Name="LockButton"
                                        Style="{StaticResource Cubby.Button.Icon}"
                                        Margin="0,0,2,0"
                                        ToolTip="锁定后不能拖动与缩放"
                                        Click="OnToggleLock" />
                                <Button x:Name="CollapseButton"
                                        Style="{StaticResource Cubby.Button.Icon}"
                                        Margin="0,0,10,0"
                                        ToolTip="折叠 / 展开"
                                        Click="OnToggleCollapse" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="ItemArea"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10,4,6,8">
                        <ItemsControl x:Name="ItemsHost">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel x:Name="ItemsPanelHost" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                </DockPanel>

                <!--
                    玻璃顶部受光：盒子内侧一条 1px 的白色渐隐线。
                    这是"玻璃板"而不是"黑板"的关键一笔——它让顶部看起来是被光照到的边。
                    必须在盒子矩形内（P2），所以只占顶部 1px，绝不向外扩。
                -->
                <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#00FFFFFF" />
                            <GradientStop Offset="0.3" Color="#4DFFFFFF" />
                            <GradientStop Offset="0.7" Color="#4DFFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <!-- 右下角缩放手柄：透明底保证 16×16 都能抓到，上面两道斜角短线比实心方块克制 -->
        <Canvas x:Name="ResizeGrip"
                Width="16"
                Height="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,3,3"
                Cursor="SizeNWSE"
                ToolTip="拖动调整盒子大小"
                MouseLeftButtonDown="OnGripMouseDown"
                MouseMove="OnGripMouseMove"
                MouseLeftButtonUp="OnGripMouseUp">
            <Rectangle Width="16" Height="16" Fill="Transparent" />
            <Line X1="11" Y1="15" X2="15" Y2="11" Stroke="#B3FFFFFF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line X1="5" Y1="15" X2="15" Y2="5" Stroke="#66FFFFFF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line X1="1" Y1="15" X2="15" Y2="1" Stroke="#33FFFFFF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Canvas>
    </Grid>
</UserControl>