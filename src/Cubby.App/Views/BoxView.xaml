<UserControl x:Class="Cubby.App.Views.BoxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             DragOver="OnDragOver"
             Drop="OnDrop">
    <Grid>
        <Border x:Name="Root"
                BorderThickness="2">
            <DockPanel>

                <Border x:Name="TitleBar"
                        DockPanel.Dock="Top"
                        Height="34"
                        CornerRadius="10,10,0,0"
                        Background="#33000000"
                        MouseLeftButtonDown="OnTitleMouseDown"
                        MouseMove="OnTitleMouseMove"
                        MouseLeftButtonUp="OnTitleMouseUp">
                    <Grid>
                        <TextBlock x:Name="TitleText"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="LockButton"
                                    Width="28"
                                    Height="24"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    FontSize="12"
                                    ToolTip="锁定后不能拖动与缩放"
                                    Click="OnToggleLock" />
                            <Button x:Name="CollapseButton"
                                    Width="28"
                                    Height="24"
                                    Margin="0,0,8,0"
                                    Padding="0"
                                    FontSize="12"
                                    ToolTip="折叠 / 展开"
                                    Click="OnToggleCollapse" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="ItemArea" VerticalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl x:Name="ItemsHost">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel x:Name="ItemsPanelHost" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- 右下角缩放手柄 -->
        <Rectangle x:Name="ResizeGrip"
                   Width="16"
                   Height="16"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   RadiusX="3"
                   RadiusY="3"
                   Fill="#660FDC78"
                   Cursor="SizeNWSE"
                   ToolTip="拖动调整盒子大小"
                   MouseLeftButtonDown="OnGripMouseDown"
                   MouseMove="OnGripMouseMove"
                   MouseLeftButtonUp="OnGripMouseUp" />
    </Grid>
</UserControl>