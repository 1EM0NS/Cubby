<UserControl x:Class="Cubby.App.Views.BoxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             DragOver="OnDragOver"
             Drop="OnDrop">
    <!--
        设计约束（P2）：盒子的所有绘制都必须落在盒子矩形内部。
        这里刻意不使用任何**向外扩散**的 Effect（阴影会抢走盒子外的点击）；
        BackdropImage 的模糊被圆角 Clip 严格限制在盒子矩形内，是安全的。
        观感对照 DeskBox（Tianyu199509/DeskBox, GPL-3.0）：模糊壁纸 + 深色罩的亚克力底层、
        无边框描边、标题栏按钮悬停才出现。
    -->
    <Grid>
        <Border x:Name="Root" BorderThickness="0">
            <Grid>
                <!-- 亚克力底层：壁纸裁剪 + 高斯模糊（DeskBox 的 Acrylic 材质）。
                     没有壁纸（纯色桌面）时保持 Collapsed，由 TintPlate 的渐变罩兜底。 -->
                <Image x:Name="BackdropImage"
                       Stretch="Fill"
                       Visibility="Collapsed"
                       IsHitTestVisible="False">
                    <Image.Effect>
                        <!-- 圆角裁切内的模糊；扩边取样由 WallpaperBackdrop.Crop 保证 -->
                        <BlurEffect Radius="40" />
                    </Image.Effect>
                </Image>

                <!-- 深色罩：决定盒子的明暗；透明度跟随用户设置（亚克力层的"浓度"） -->
                <Border x:Name="TintPlate" CornerRadius="8" />

                <Grid>
                    <!--
                        左侧强调条：**默认不显示**，只在"需要提醒"的状态下由代码点亮
                        （锁定 / 映射文件夹）。普通盒子不画任何色条——
                        桌面上一眼望去全是彩色竖条，是上一版最刺眼的观感问题。
                    -->
                    <Border x:Name="AccentBar"
                            Width="2.5"
                            Height="22"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            CornerRadius="1.25"
                            Margin="0,7,0,0"
                            Visibility="Collapsed" />

                    <DockPanel>

                        <Border x:Name="TitleBar"
                                DockPanel.Dock="Top"
                                Height="40"
                                Background="Transparent"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#0FFFFFFF"
                                MouseLeftButtonDown="OnTitleMouseDown"
                                MouseMove="OnTitleMouseMove"
                                MouseLeftButtonUp="OnTitleMouseUp">
                            <Grid>
                                <TextBlock x:Name="TitleIcon"
                                           Margin="14,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Cubby.Font.Icon}"
                                           FontSize="11"
                                           Visibility="Collapsed" />

                                <TextBlock x:Name="TitleText"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />

                                <!--
                                    标题栏按钮：DeskBox 的做法是悬停盒子才出现（平时桌面干净）。
                                    透明时同时关掉命中，避免一排看不见的按钮挡住标题栏点击。
                                -->
                                <StackPanel x:Name="TitleActions"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Opacity="0"
                                            IsHitTestVisible="False">
                                    <Button x:Name="DesktopIconButton"
                                            Style="{StaticResource Cubby.Button.Icon}"
                                            Margin="0,0,2,0"
                                            ToolTip="隐藏 / 显示真实桌面图标（Ctrl+Alt+H）"
                                            Click="OnToggleDesktopIcons" />
                                    <Button x:Name="SearchButton"
                                            Style="{StaticResource Cubby.Button.Icon}"
                                            Margin="0,0,2,0"
                                            ToolTip="搜索这个盒子里的条目"
                                            Click="OnSearch" />
                                    <Button x:Name="LockButton"
                                            Style="{StaticResource Cubby.Button.Icon}"
                                            Margin="0,0,2,0"
                                            ToolTip="锁定后不能拖动与缩放"
                                            Click="OnToggleLock" />
                                    <Button x:Name="CollapseButton"
                                            Style="{StaticResource Cubby.Button.Icon}"
                                            Margin="0,0,12,0"
                                            ToolTip="折叠 / 展开"
                                            Click="OnToggleCollapse" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer x:Name="ItemArea"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="10,6,6,8">
                            <ItemsControl x:Name="ItemsHost">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel x:Name="ItemsPanelHost" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                    </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 右下角缩放手柄：透明底保证 16×16 都能抓到，上面两道斜角短线比实心方块克制 -->
        <Canvas x:Name="ResizeGrip"
                Width="16"
                Height="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,3,3"
                Cursor="SizeNWSE"
                ToolTip="拖动调整盒子大小"
                MouseLeftButtonDown="OnGripMouseDown"
                MouseMove="OnGripMouseMove"
                MouseLeftButtonUp="OnGripMouseUp">
            <Rectangle Width="16" Height="16" Fill="Transparent" />
            <Line X1="11" Y1="15" X2="15" Y2="11" Stroke="#B3FFFFFF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line X1="5" Y1="15" X2="15" Y2="5" Stroke="#66FFFFFF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Line X1="1" Y1="15" X2="15" Y2="1" Stroke="#33FFFFFF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Canvas>
    </Grid>
</UserControl>