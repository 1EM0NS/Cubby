<Window x:Class="Cubby.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBox x:Name="Input" Padding="6" FontSize="14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确定" Width="84" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
            <Button Content="取消" Width="84" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>