<Window x:Class="Cubby.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="420"
        SizeToContent="Height"
        Style="{StaticResource Cubby.Window}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" Margin="0,0,0,10" TextWrapping="Wrap" />
        <TextBox x:Name="Input" FontSize="14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource Cubby.Button.Primary}" Content="确定" Width="88" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
            <Button Content="取消" Width="88" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>