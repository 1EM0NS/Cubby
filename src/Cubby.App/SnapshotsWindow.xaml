<Window x:Class="Cubby.App.SnapshotsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cubby · 布局快照"
        Width="680"
        Height="540"
        Style="{StaticResource Cubby.Window}"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="布局快照" Style="{StaticResource Cubby.H1}" />
            <TextBlock Margin="0,6,0,12"
                       Style="{StaticResource Cubby.Caption}"
                       Text="快照是 layout.json 的历史副本，放在 %AppData%\Cubby\snapshots\。还原只改 Cubby 自己的配置，不动任何文件实体。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="保留份数：" VerticalAlignment="Center" />
                <TextBox x:Name="KeepBox" Grid.Column="1" VerticalAlignment="Center" />
                <Button Grid.Column="2" Margin="8,0,0,0" Padding="12,5" Content="设置" Click="OnApplyKeep" />
                <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Cubby.Caption}"
                           Text="0 表示不自动清理；超出份数的旧快照会在新建时删除。" />
            </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <UniformGrid Columns="3">
                <Button Style="{StaticResource Cubby.Button.Primary}" Content="新建快照" Margin="0,0,5,0" Padding="8" Click="OnCreate" />
                <Button Content="还原所选" Margin="5,0,5,0" Padding="8" Click="OnRestore" />
                <Button Content="打开快照目录" Margin="5,0,0,0" Padding="8" Click="OnOpenFolder" />
            </UniformGrid>
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Cubby.Brush.Ok}" />
        </StackPanel>

        <Border Style="{StaticResource Cubby.Card}" Padding="4">
            <ListBox x:Name="SnapshotList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Summary}" FontFamily="{StaticResource Cubby.Font.Mono}" FontSize="12" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

    </DockPanel>
</Window>