<Window x:Class="Cubby.App.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cubby · 出了点问题"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Style="{StaticResource Cubby.Window}"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="22">

        <StackPanel Orientation="Horizontal">
            <Border Width="34"
                    Height="34"
                    CornerRadius="10"
                    Background="{StaticResource Cubby.Brush.AccentDeep}"
                    VerticalAlignment="Top">
                <TextBlock Text="&#xE7BA;"
                           FontFamily="{StaticResource Cubby.Font.Icon}"
                           FontSize="16"
                           Foreground="{StaticResource Cubby.Brush.Warn}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeadlineText"
                           Text="Cubby 遇到了一个未处理的异常"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SourceText" Margin="0,4,0,0" Style="{StaticResource Cubby.Caption}" />
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource Cubby.Card}" Margin="0,16,0,0" Padding="12">
            <StackPanel>
                <TextBlock Text="异常摘要" Style="{StaticResource Cubby.Section}" Margin="0,0,0,6" />
                <TextBox x:Name="SummaryBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="120"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="{StaticResource Cubby.Font.Mono}"
                         FontSize="12" />
            </StackPanel>
        </Border>

        <TextBlock Margin="0,16,0,0"
                   Style="{StaticResource Cubby.Caption}"
                   Text="已把完整堆栈写进下面的日志文件（含版本、系统与运行时信息）。把这个文件发出去就能定位问题。" />

        <Border Style="{StaticResource Cubby.Card}" Margin="0,8,0,0" Padding="12">
            <StackPanel>
                <TextBlock Text="日志文件" Style="{StaticResource Cubby.Section}" Margin="0,0,0,6" />
                <TextBox x:Name="LogPathBox"
                         IsReadOnly="True"
                         FontFamily="{StaticResource Cubby.Font.Mono}"
                         FontSize="12" />
                <TextBlock x:Name="StatusText"
                           Margin="0,8,0,0"
                           Style="{StaticResource Cubby.Caption}"
                           Foreground="{StaticResource Cubby.Brush.Accent}"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <TextBlock Margin="0,14,0,0"
                   Style="{StaticResource Cubby.Caption}"
                   Foreground="{StaticResource Cubby.Brush.Text}"
                   Text="桌面图标若曾被 Cubby 隐藏，已经先一步恢复显示——这一步排在写日志之前。" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CopyButton"
                    Margin="0,0,8,0"
                    Padding="14,7"
                    Content="复制路径"
                    Click="OnCopyPath" />
            <Button x:Name="OpenFolderButton"
                    Margin="0,0,8,0"
                    Padding="14,7"
                    Content="打开日志目录"
                    Click="OnOpenFolder" />
            <Button x:Name="CloseButton"
                    Style="{StaticResource Cubby.Button.Primary}"
                    Padding="18,7"
                    Content="知道了"
                    IsDefault="True"
                    Click="OnClose" />
        </StackPanel>
    </StackPanel>
</Window>
