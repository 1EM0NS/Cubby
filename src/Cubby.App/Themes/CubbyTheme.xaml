<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Cubby 统一主题。
        约束（务必遵守）：盒子浮层之外必须仍是 alpha=0 —— 任何 alpha>0 的像素都会抢点击（P2）。
        因此本主题只定义颜色与控件样式，**不定义任何外扩的 Effect**（DropShadowEffect / BlurEffect 会向外扩散）。
        盒子内部想要的"立体感"一律用渐变与内描边实现，见 BoxView.xaml。
    -->

    <!-- ================= 色板 =================
         对齐 Windows 11 深色模式的取值：
         · 背景用**中性灰** #202020 一族，而不是带蓝的深色——带蓝的底跟系统界面摆在一起会显"脏"；
         · 强调色用系统的浅蓝 #4CC2FF，而不是高饱和的荧光绿。桌面是用户的，
           工具不该在别人的墙上刷自己的漆；需要提醒时才局部用色（见 BoxView 的强调条）。
    -->
    <Color x:Key="Cubby.Color.Bg">#202020</Color>
    <Color x:Key="Cubby.Color.Surface">#2B2B2B</Color>
    <Color x:Key="Cubby.Color.SurfaceAlt">#323232</Color>
    <Color x:Key="Cubby.Color.SurfaceHover">#3B3B3B</Color>
    <Color x:Key="Cubby.Color.Border">#3D3D3D</Color>
    <Color x:Key="Cubby.Color.BorderStrong">#4D4D4D</Color>
    <Color x:Key="Cubby.Color.Text">#F2F2F2</Color>
    <Color x:Key="Cubby.Color.TextMuted">#C6C6C6</Color>
    <Color x:Key="Cubby.Color.TextDim">#8C8C8C</Color>
    <Color x:Key="Cubby.Color.Accent">#4CC2FF</Color>
    <Color x:Key="Cubby.Color.AccentDim">#3A9BD5</Color>
    <Color x:Key="Cubby.Color.AccentDeep">#1B3D52</Color>
    <Color x:Key="Cubby.Color.Warn">#FFC83D</Color>
    <Color x:Key="Cubby.Color.Info">#5FD3A6</Color>
    <Color x:Key="Cubby.Color.Track">#4D4D4D</Color>

    <SolidColorBrush x:Key="Cubby.Brush.Bg" Color="{StaticResource Cubby.Color.Bg}" />
    <SolidColorBrush x:Key="Cubby.Brush.Surface" Color="{StaticResource Cubby.Color.Surface}" />
    <SolidColorBrush x:Key="Cubby.Brush.SurfaceAlt" Color="{StaticResource Cubby.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Cubby.Brush.SurfaceHover" Color="{StaticResource Cubby.Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Cubby.Brush.Border" Color="{StaticResource Cubby.Color.Border}" />
    <SolidColorBrush x:Key="Cubby.Brush.BorderStrong" Color="{StaticResource Cubby.Color.BorderStrong}" />
    <SolidColorBrush x:Key="Cubby.Brush.Text" Color="{StaticResource Cubby.Color.Text}" />
    <SolidColorBrush x:Key="Cubby.Brush.TextMuted" Color="{StaticResource Cubby.Color.TextMuted}" />
    <SolidColorBrush x:Key="Cubby.Brush.TextDim" Color="{StaticResource Cubby.Color.TextDim}" />
    <SolidColorBrush x:Key="Cubby.Brush.Accent" Color="{StaticResource Cubby.Color.Accent}" />
    <SolidColorBrush x:Key="Cubby.Brush.AccentDim" Color="{StaticResource Cubby.Color.AccentDim}" />
    <SolidColorBrush x:Key="Cubby.Brush.AccentDeep" Color="{StaticResource Cubby.Color.AccentDeep}" />
    <SolidColorBrush x:Key="Cubby.Brush.Warn" Color="{StaticResource Cubby.Color.Warn}" />
    <SolidColorBrush x:Key="Cubby.Brush.Info" Color="{StaticResource Cubby.Color.Info}" />
    <SolidColorBrush x:Key="Cubby.Brush.Track" Color="{StaticResource Cubby.Color.Track}" />

    <!-- 提示文字的两种语义色：成功 / 需要注意 -->
    <SolidColorBrush x:Key="Cubby.Brush.Ok" Color="{StaticResource Cubby.Color.Accent}" />
    <SolidColorBrush x:Key="Cubby.Brush.Caution" Color="{StaticResource Cubby.Color.Warn}" />

    <!-- ================= 转换器 =================
         BooleanToVisibilityConverter **不是** WPF 的免声明内置资源（踩过：XamlParseException
         "在 StaticResourceHolder 上提供值时引发了异常"），用之前必须在这里声明。 -->
    <BooleanToVisibilityConverter x:Key="Cubby.BoolToVisibility" />

    <!-- ================= 字体 ================= -->
    <!-- 优先 Segoe UI Variable（Windows 11 的系统字体），Win10 回退 Segoe UI；
         中文字形这两者都没有，会逐字回退到微软雅黑——和 Windows 自己的做法一致 -->
    <FontFamily x:Key="Cubby.Font.Ui">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Segoe UI Emoji</FontFamily>
    <FontFamily x:Key="Cubby.Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <!-- 图标字体：全部界面图标统一用它的矢量字形，比彩色 emoji 干净，且跟随前景色 -->
    <FontFamily x:Key="Cubby.Font.Icon">Segoe MDL2 Assets</FontFamily>

    <!-- ================= 排版 ================= -->
    <Style x:Key="Cubby.H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
    </Style>

    <Style x:Key="Cubby.Caption" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.TextMuted}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style x:Key="Cubby.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 章节小标题 -->
    <Style x:Key="Cubby.Section" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <!-- ================= 窗口 ================= -->
    <Style x:Key="Cubby.Window" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Cubby.Brush.Bg}" />
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- ================= 按钮 ================= -->
    <!-- 次要按钮（默认）：深色面 + 细边，悬停提亮，按下压暗 -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="Background" Value="{StaticResource Cubby.Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource Cubby.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Cubby.Brush.SurfaceHover}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Cubby.Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Cubby.Brush.AccentDeep}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Cubby.Brush.AccentDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主要按钮：强调色实底，字用深色 -->
    <Style x:Key="Cubby.Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Cubby.Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Cubby.Brush.AccentDim}" />
        <Setter Property="Foreground" Value="#07120C" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Cubby.Brush.AccentDim}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Cubby.Brush.AccentDeep}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标题栏上的小图标按钮：无边框、方形、悬停才有底色（盒子内使用） -->
    <Style x:Key="Cubby.Button.Icon" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Icon}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#C8D2DC" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#55FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 盒子里的条目磁贴：透明底 + 极淡的悬停高亮，全部在盒子内部（P2） -->
    <Style x:Key="Cubby.ItemTile" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="4,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <!-- 悬停只加一层很淡的白，不再同时描边——
                     桌面图标本身的悬停反馈就是这么轻，多画一圈会让整块磁贴显得"被框住" -->
                <Setter Property="Background" Value="#1FFFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= 输入 ================= -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Cubby.Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Cubby.Brush.AccentDim}" />
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{StaticResource Cubby.Brush.SurfaceAlt}"
                            BorderBrush="{StaticResource Cubby.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Cubby.Brush.AccentDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="16"
                                Height="16"
                                CornerRadius="4"
                                Background="{StaticResource Cubby.Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Cubby.Brush.BorderStrong}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="Tick"
                                       Text="&#xE73E;"
                                       FontFamily="{StaticResource Cubby.Font.Icon}"
                                       FontSize="10"
                                       Foreground="#07120C"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Cubby.Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Cubby.Brush.AccentDim}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Cubby.Brush.AccentDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 列表 ================= -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Cubby.Brush.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Cubby.Brush.AccentDeep}" />
                            <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 列表 / 日志的容器：统一圆角与描边 -->
    <Style x:Key="Cubby.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Cubby.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Cubby.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <!-- ================= 滑块 ================= -->
    <Style TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4"
                                CornerRadius="2"
                                Background="{StaticResource Cubby.Brush.Track}" />
                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource Cubby.Brush.Accent}"
                                                     Stroke="{StaticResource Cubby.Brush.Bg}"
                                                     StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 滚动条（细） ================= -->
    <Style x:Key="Cubby.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource Cubby.Brush.BorderStrong}"
                            CornerRadius="4"
                            Margin="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Cubby.ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 菜单 =================
         照 Windows 11 的 Flyout 写：深色面 + 8px 圆角 + 32px 行高 + 4px 行圆角 + 淡阴影。

         ⚠️ 这里**必须给完整 ControlTemplate**。WPF 默认的 ContextMenu / MenuItem 模板自带一套
         浅色 chrome，只设 Background / Foreground 是盖不住的——踩过一次：深色盒子里弹出一个
         纯白菜单，文字还是黑的，非常刺眼。凡是要改外观的系统控件都同理。
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Cubby.Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="BorderBrush" Value="#1FFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Ui}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid>
                        <!-- 外观只包这一层；Margin 留给阴影（菜单是独立 Popup，不受 P2 约束） -->
                        <Border x:Name="MenuRoot"
                                Margin="10"
                                Padding="4"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="3"
                                                  Direction="270"
                                                  Opacity="0.45"
                                                  Color="#000000" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>

                        <!-- ⚠️ 这个 Popup 不能删：WPF 的 ContextMenu 正是靠模板里的 PART_Popup 才能打开，
                             它同时也是子菜单的宿主。本程序的菜单没有二级菜单，但少了它菜单就弹不出来。 -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               Placement="Bottom"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Padding="4"
                                    CornerRadius="8"
                                    Background="{StaticResource Cubby.Brush.Surface}"
                                    BorderBrush="#1FFFFFFF"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Ui}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="32" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Chrome"
                            CornerRadius="4"
                            Padding="12,0"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停用很淡的白，和清单项的悬停是同一套语言 -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#16FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Margin="8,4"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 提示气泡 =================
         ToolTip 默认走系统色（浅黄底 + 黑字），在深色界面上是"一块突然亮起来的牌子"。
         这里给它完整模板，与菜单同一套观感。
         ⚠️ 同样**不加投影**：条目也有 ToolTip，而它们渲染在盒子浮层里，
         任何向外扩散的 Effect 都会破坏 P2（盒子外必须 alpha=0）。 -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Cubby.Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Cubby.Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border CornerRadius="5"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>