<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Cubby 统一主题。
        约束（务必遵守）：盒子浮层之外必须仍是 alpha=0 —— 任何 alpha>0 的像素都会抢点击（P2）。
        因此本主题只定义颜色与控件样式，**不定义任何外扩的 Effect**（DropShadowEffect / BlurEffect 会向外扩散）。
        盒子内部想要的"立体感"一律用渐变与内描边实现，见 BoxView.xaml。
    -->

    <!-- ================= 色板 ================= -->
    <Color x:Key="Cubby.Color.Bg">#0D1217</Color>
    <Color x:Key="Cubby.Color.Surface">#151C23</Color>
    <Color x:Key="Cubby.Color.SurfaceAlt">#1C2530</Color>
    <Color x:Key="Cubby.Color.SurfaceHover">#243040</Color>
    <Color x:Key="Cubby.Color.Border">#27323E</Color>
    <Color x:Key="Cubby.Color.BorderStrong">#3B4A58</Color>
    <Color x:Key="Cubby.Color.Text">#E8EDF3</Color>
    <Color x:Key="Cubby.Color.TextMuted">#97A4B1</Color>
    <Color x:Key="Cubby.Color.TextDim">#66737F</Color>
    <Color x:Key="Cubby.Color.Accent">#0FDC78</Color>
    <Color x:Key="Cubby.Color.AccentDim">#0BA95C</Color>
    <Color x:Key="Cubby.Color.AccentDeep">#123D2A</Color>
    <Color x:Key="Cubby.Color.Warn">#EFAA17</Color>
    <Color x:Key="Cubby.Color.Info">#7CC0FF</Color>
    <Color x:Key="Cubby.Color.Track">#2A3542</Color>

    <SolidColorBrush x:Key="Cubby.Brush.Bg" Color="{StaticResource Cubby.Color.Bg}" />
    <SolidColorBrush x:Key="Cubby.Brush.Surface" Color="{StaticResource Cubby.Color.Surface}" />
    <SolidColorBrush x:Key="Cubby.Brush.SurfaceAlt" Color="{StaticResource Cubby.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Cubby.Brush.SurfaceHover" Color="{StaticResource Cubby.Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Cubby.Brush.Border" Color="{StaticResource Cubby.Color.Border}" />
    <SolidColorBrush x:Key="Cubby.Brush.BorderStrong" Color="{StaticResource Cubby.Color.BorderStrong}" />
    <SolidColorBrush x:Key="Cubby.Brush.Text" Color="{StaticResource Cubby.Color.Text}" />
    <SolidColorBrush x:Key="Cubby.Brush.TextMuted" Color="{StaticResource Cubby.Color.TextMuted}" />
    <SolidColorBrush x:Key="Cubby.Brush.TextDim" Color="{StaticResource Cubby.Color.TextDim}" />
    <SolidColorBrush x:Key="Cubby.Brush.Accent" Color="{StaticResource Cubby.Color.Accent}" />
    <SolidColorBrush x:Key="Cubby.Brush.AccentDim" Color="{StaticResource Cubby.Color.AccentDim}" />
    <SolidColorBrush x:Key="Cubby.Brush.AccentDeep" Color="{StaticResource Cubby.Color.AccentDeep}" />
    <SolidColorBrush x:Key="Cubby.Brush.Warn" Color="{StaticResource Cubby.Color.Warn}" />
    <SolidColorBrush x:Key="Cubby.Brush.Info" Color="{StaticResource Cubby.Color.Info}" />
    <SolidColorBrush x:Key="Cubby.Brush.Track" Color="{StaticResource Cubby.Color.Track}" />

    <!-- 提示文字的两种语义色：成功 / 需要注意 -->
    <SolidColorBrush x:Key="Cubby.Brush.Ok" Color="{StaticResource Cubby.Color.Accent}" />
    <SolidColorBrush x:Key="Cubby.Brush.Caution" Color="{StaticResource Cubby.Color.Warn}" />

    <!-- ================= 字体 ================= -->
    <FontFamily x:Key="Cubby.Font.Ui">Microsoft YaHei UI, Segoe UI, Segoe UI Emoji</FontFamily>
    <FontFamily x:Key="Cubby.Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <!-- 图标字体：全部界面图标统一用它的矢量字形，比彩色 emoji 干净，且跟随前景色 -->
    <FontFamily x:Key="Cubby.Font.Icon">Segoe MDL2 Assets</FontFamily>

    <!-- ================= 排版 ================= -->
    <Style x:Key="Cubby.H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
    </Style>

    <Style x:Key="Cubby.Caption" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.TextMuted}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style x:Key="Cubby.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 章节小标题 -->
    <Style x:Key="Cubby.Section" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <!-- ================= 窗口 ================= -->
    <Style x:Key="Cubby.Window" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Cubby.Brush.Bg}" />
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- ================= 按钮 ================= -->
    <!-- 次要按钮（默认）：深色面 + 细边，悬停提亮，按下压暗 -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="Background" Value="{StaticResource Cubby.Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource Cubby.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Cubby.Brush.SurfaceHover}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Cubby.Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Cubby.Brush.AccentDeep}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Cubby.Brush.AccentDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主要按钮：强调色实底，字用深色 -->
    <Style x:Key="Cubby.Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Cubby.Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Cubby.Brush.AccentDim}" />
        <Setter Property="Foreground" Value="#07120C" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Cubby.Brush.AccentDim}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Cubby.Brush.AccentDeep}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标题栏上的小图标按钮：无边框、方形、悬停才有底色（盒子内使用） -->
    <Style x:Key="Cubby.Button.Icon" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Icon}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#C8D2DC" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#55FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 盒子里的条目磁贴：透明底 + 悬停高亮，全部在盒子内部（P2） -->
    <Style x:Key="Cubby.ItemTile" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="4,7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#26FFFFFF" />
                <Setter Property="BorderBrush" Value="#40FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 条目图标底座 -->
    <Style x:Key="Cubby.Badge" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ================= 输入 ================= -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Cubby.Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Cubby.Brush.AccentDim}" />
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{StaticResource Cubby.Brush.SurfaceAlt}"
                            BorderBrush="{StaticResource Cubby.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Cubby.Brush.AccentDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="16"
                                Height="16"
                                CornerRadius="4"
                                Background="{StaticResource Cubby.Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Cubby.Brush.BorderStrong}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="Tick"
                                       Text="&#xE73E;"
                                       FontFamily="{StaticResource Cubby.Font.Icon}"
                                       FontSize="10"
                                       Foreground="#07120C"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Cubby.Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Cubby.Brush.AccentDim}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Cubby.Brush.AccentDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 列表 ================= -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Cubby.Brush.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Cubby.Brush.AccentDeep}" />
                            <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 列表 / 日志的容器：统一圆角与描边 -->
    <Style x:Key="Cubby.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Cubby.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Cubby.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <!-- ================= 滑块 ================= -->
    <Style TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4"
                                CornerRadius="2"
                                Background="{StaticResource Cubby.Brush.Track}" />
                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource Cubby.Brush.Accent}"
                                                     Stroke="{StaticResource Cubby.Brush.Bg}"
                                                     StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 滚动条（细） ================= -->
    <Style x:Key="Cubby.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource Cubby.Brush.BorderStrong}"
                            CornerRadius="4"
                            Margin="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Cubby.ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 菜单 ================= -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Cubby.Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Cubby.Brush.BorderStrong}" />
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Cubby.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Cubby.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Cubby.Brush.Border}" />
    </Style>

</ResourceDictionary>