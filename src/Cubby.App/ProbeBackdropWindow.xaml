<Window x:Class="Cubby.App.ProbeBackdropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cubby 自测背景层"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="0"
        Top="0"
        Background="#FF0F1418">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Cubby 自测背景层"
                       FontSize="22"
                       Foreground="#FFE5E5E5"
                       HorizontalAlignment="Center" />
            <TextBlock Margin="0,12,0,0"
                       FontSize="14"
                       Foreground="#FFA1A1AA"
                       TextAlignment="Center"
                       Text="这是受控背景层，用于证明「浮层透明区域的点击确实落到了下层窗口」。" />
            <TextBlock Margin="0,4,0,0"
                       FontSize="14"
                       Foreground="#FFA1A1AA"
                       TextAlignment="Center"
                       Text="几秒后自动结束，期间请勿操作鼠标。" />
            <TextBlock x:Name="CountText"
                       Margin="0,20,0,0"
                       FontSize="16"
                       FontFamily="Consolas"
                       Foreground="#FF0FDC78"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>