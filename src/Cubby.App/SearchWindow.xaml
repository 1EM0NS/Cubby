<Window x:Class="Cubby.App.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cubby · 搜索条目"
        Width="480"
        Height="460"
        Style="{StaticResource Cubby.Window}"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="18">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" />
            <TextBox x:Name="QueryBox"
                     Margin="0,10,0,0"
                     FontSize="14"
                     TextChanged="OnQueryChanged"
                     KeyDown="OnQueryKeyDown" />
            <TextBlock x:Name="StatusText"
                       Margin="0,8,0,0"
                       Style="{StaticResource Cubby.Caption}" />
        </StackPanel>

        <Border Margin="0,12,0,0" Style="{StaticResource Cubby.Card}" Padding="4">
            <ListBox x:Name="ResultList" MouseDoubleClick="OnOpenSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                            <TextBlock Text="{Binding TargetPath}"
                                       FontSize="11"
                                       Foreground="{StaticResource Cubby.Brush.TextDim}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

    </DockPanel>
</Window>