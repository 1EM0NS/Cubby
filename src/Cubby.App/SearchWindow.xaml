<Window x:Class="Cubby.App.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cubby · 搜索条目"
        Width="460"
        Height="440"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="14">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" />
            <TextBox x:Name="QueryBox"
                     Margin="0,10,0,0"
                     Padding="6"
                     FontSize="14"
                     TextChanged="OnQueryChanged"
                     KeyDown="OnQueryKeyDown" />
            <TextBlock x:Name="StatusText"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="#52525B" />
        </StackPanel>

        <Border Margin="0,10,0,0" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="8" Padding="4">
            <ListBox x:Name="ResultList"
                     BorderThickness="0"
                     MouseDoubleClick="OnOpenSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,2">
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                            <TextBlock Text="{Binding TargetPath}"
                                       FontSize="11"
                                       Foreground="#71717A"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

    </DockPanel>
</Window>